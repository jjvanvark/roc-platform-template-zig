{
  // ===========================================================================
  // Reference config for a Worker built on this Roc platform.
  //
  // Copy this to wrangler.jsonc in your own project and delete what you do not
  // use. Every binding block is commented out: an unused binding still has to
  // resolve on deploy, so a block you are not using is a block that will fail.
  //
  // The demo Worker in this repo has its own, much smaller wrangler.jsonc.
  // ===========================================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-roc-worker",

  // The entry point gen_entry writes during `npm run build`. It re-exports the
  // handler from workers-zig's shim.js; you do not edit or write it yourself.
  "main": "worker/entry.js",
  "compatibility_date": "2026-08-01",

  // ---------------------------------------------------------------------------
  // Required by the platform. Both of these are load-bearing — a Worker on this
  // platform will not start without them, whatever bindings it uses.
  // ---------------------------------------------------------------------------

  // workers-zig's shim.js imports node:fs / node:path / node:stream for its
  // WASI and socket support, so the runtime needs the Node compat layer.
  "compatibility_flags": ["nodejs_compat"],

  // Loads worker.wasm as a compiled-wasm module rather than treating it as an
  // asset. Without this the shim has no module to instantiate.
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": false,
    },
  ],

  // ---------------------------------------------------------------------------
  // Bindings
  //
  // `wrangler dev` simulates every binding locally and accepts any value, so a
  // config that works locally can still fail on deploy with errors like
  // "KV namespace '...' is not valid [code: 10042]". Each value below other
  // than `binding` has to name a resource that exists in the account.
  //
  // `binding` is the only field chosen freely: it is the string the Roc app
  // passes, e.g. Kv.get!("COUNTER", "hits").
  //
  // R2 and Queues need a paid Workers plan; KV and D1 work on the free tier.
  // ---------------------------------------------------------------------------

  // Read from Roc with Kv.get!("COUNTER", key) / Kv.put!(...)
  //
  // npx wrangler kv namespace create COUNTER
  // -> prints the 32-char hex namespace id, which is what `id` wants
  // "kv_namespaces": [
  //   {
  //     "binding": "COUNTER",
  //     "id": "REPLACE_ME_with_the_32_char_hex_id_wrangler_prints",
  //   },
  // ],

  // Read from Roc with R2.get!("BUCKET", key) / R2.put!(...), which take and
  // return List(U8), so objects can be images or archives as well as text.
  //
  // npx wrangler r2 bucket create my-bucket
  // -> R2 has no id; `bucket_name` is the real bucket name
  // "r2_buckets": [
  //   {
  //     "binding": "BUCKET",
  //     "bucket_name": "my-bucket",
  //   },
  // ],

  // Read from Roc with D1.query!("DB", sql, params_json) / D1.execute!(...)
  //
  // npx wrangler d1 create my-db
  // -> prints the database UUID for `database_id`; `database_name` must match
  //    the name passed to the create command
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "my-db",
  //     "database_id": "REPLACE_ME_with_the_uuid_wrangler_d1_create_prints",
  //   },
  // ],

  // Written from Roc with Queue.send!("JOBS", body). Producing only — consuming
  // needs a `queue` handler, which the platform does not expose yet, so do not
  // add a `consumers` block expecting Roc to receive from it.
  //
  // npx wrangler queues create my-jobs
  // -> `queue` is the real queue name
  // "queues": {
  //   "producers": [
  //     {
  //       "binding": "JOBS",
  //       "queue": "my-jobs",
  //     },
  //   ],
  // },

  // Text bindings, readable from Roc with Env.get!("GREETING").
  //
  // Unlike the blocks above these need no account resource, so they always
  // resolve on deploy. Secrets are set with `wrangler secret put NAME` and read
  // through the same Env.get! — Roc cannot tell the two apart.
  // "vars": {
  //   "GREETING": "Hello from wrangler vars",
  // },
}
