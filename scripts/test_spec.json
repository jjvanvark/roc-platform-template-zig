{
  "stages": {
    "check": true,
    "test": false,
    "build": true,
    "run": true
  },
  "apps": [
    {
      "path": "examples/hello_world.roc",
      "cases": [
        {
          "name": "happy",
          "stdout_contains": [
            "Hello, World!"
          ]
        }
      ]
    },
    {
      "path": "examples/echo.roc",
      "cases": [
        {
          "name": "defaults",
          "stdout_contains": [
            "GET http://localhost/"
          ]
        },
        {
          "name": "method-url-body-and-headers",
          "args": [
            "https://example.com/submit",
            "POST",
            "a body",
            "accept:application/json"
          ],
          "stdout_contains": [
            "POST https://example.com/submit",
            "accept: application/json",
            "a body"
          ]
        },
        {
          "name": "multibyte-body-round-trips-byte-for-byte",
          "args": [
            "https://example.com/submit",
            "POST",
            "héllo → 🌍 naïve ünicode"
          ],
          "stdout_contains": [
            "héllo → 🌍 naïve ünicode"
          ]
        }
      ]
    },
    {
      "path": "examples/logging.roc",
      "cases": [
        {
          "name": "happy",
          "args": [
            "https://example.com/log"
          ],
          "stdout_contains": [
            "handling GET https://example.com/log",
            "Logged."
          ],
          "stderr_contains": [
            "this goes to the error log"
          ]
        }
      ]
    },
    {
      "path": "examples/routing.roc",
      "cases": [
        {
          "name": "known-route",
          "args": [
            "https://example.com/health"
          ],
          "stdout_contains": [
            "ok"
          ]
        },
        {
          "name": "unknown-route",
          "args": [
            "https://example.com/nope"
          ],
          "exit_code": 1,
          "stdout_contains": [
            "not found"
          ]
        }
      ]
    },
    {
      "path": "examples/headers.roc",
      "cases": [
        {
          "name": "reads-request-header",
          "args": [
            "https://example.com/",
            "GET",
            "",
            "accept:application/json"
          ],
          "stdout_contains": [
            "accept: application/json",
            "x-powered-by: roc"
          ]
        },
        {
          "name": "missing-request-header",
          "args": [
            "https://example.com/"
          ],
          "stdout_contains": [
            "accept: (absent)"
          ]
        }
      ]
    },
    {
      "path": "examples/kv.roc",
      "cases": [
        {
          "name": "first-hit-starts-the-counter",
          "args": [
            "https://example.com/"
          ],
          "stdout_contains": [
            "hits: 1"
          ]
        }
      ]
    },
    {
      "path": "examples/r2.roc",
      "cases": [
        {
          "name": "get-missing-object",
          "args": [
            "https://example.com/thing"
          ],
          "exit_code": 1,
          "stdout_contains": [
            "not found"
          ]
        },
        {
          "name": "put-then-get-in-one-process",
          "args": [
            "https://example.com/thing",
            "PUT",
            "the payload"
          ],
          "stdout_contains": [
            "stored"
          ]
        },
        {
          "name": "put-multibyte-body",
          "args": [
            "https://example.com/thing",
            "PUT",
            "🌍 not plain ascii"
          ],
          "stdout_contains": [
            "stored"
          ]
        }
      ]
    },
    {
      "path": "examples/queue.roc",
      "cases": [
        {
          "name": "send",
          "args": [
            "https://example.com/enqueue",
            "POST",
            "resize job 7"
          ],
          "stdout_contains": [
            "queued"
          ],
          "stderr_contains": [
            "[queue JOBS] resize job 7"
          ]
        }
      ]
    },
    {
      "path": "examples/d1.roc",
      "cases": [
        {
          "name": "unavailable-natively",
          "args": [
            "https://example.com/page"
          ],
          "exit_code": 1,
          "stdout_contains": [
            "D1 is not available in the native host"
          ]
        }
      ]
    },
    {
      "path": "examples/env.roc",
      "cases": [
        {
          "name": "reads-a-set-variable",
          "args": [
            "https://example.com/"
          ],
          "env": {
            "GREETING": "hello from the test runner"
          },
          "stdout_contains": [
            "GREETING: hello from the test runner",
            "DEFINITELY_NOT_SET: (absent, as expected)"
          ]
        },
        {
          "name": "falls-back-when-unset",
          "args": [
            "https://example.com/"
          ],
          "unset_env": [
            "GREETING"
          ],
          "stdout_contains": [
            "GREETING: (no GREETING set)"
          ]
        }
      ]
    }
  ]
}
