{
  "stages": {
    "check": true,
    "test": false,
    "build": true,
    "run": true
  },
  "apps": [
    {
      "path": "examples/hello_world.roc",
      "cases": [
        {
          "name": "happy",
          "stdout_contains": ["Hello, World!"]
        }
      ]
    },
    {
      "path": "examples/echo.roc",
      "cases": [
        {
          "name": "defaults",
          "stdout_contains": ["GET http://localhost/"]
        },
        {
          "name": "method-url-and-body",
          "args": ["https://example.com/submit", "POST", "a body"],
          "stdout_contains": ["POST https://example.com/submit", "a body"]
        }
      ]
    },
    {
      "path": "examples/logging.roc",
      "cases": [
        {
          "name": "happy",
          "args": ["https://example.com/log"],
          "stdout_contains": ["handling GET https://example.com/log", "Logged."],
          "stderr_contains": ["this goes to the error log"]
        }
      ]
    },
    {
      "path": "examples/routing.roc",
      "cases": [
        {
          "name": "known-route",
          "args": ["https://example.com/health"],
          "stdout_contains": ["ok"]
        },
        {
          "name": "unknown-route",
          "args": ["https://example.com/nope"],
          "exit_code": 1,
          "stdout_contains": ["not found"]
        }
      ]
    }
  ]
}
