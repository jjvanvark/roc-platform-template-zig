{
  "stages": {
    "check": true,
    "test": false,
    "build": true,
    "run": true
  },
  "apps": [
    {
      "path": "examples/hello_world.roc",
      "cases": [
        {
          "name": "happy",
          "stdout_contains": [
            "Hello, World!"
          ]
        }
      ]
    },
    {
      "path": "examples/echo.roc",
      "cases": [
        {
          "name": "defaults",
          "stdout_contains": [
            "GET http://localhost/"
          ]
        },
        {
          "name": "method-url-body-and-headers",
          "args": [
            "https://example.com/submit",
            "POST",
            "a body",
            "accept:application/json"
          ],
          "stdout_contains": [
            "POST https://example.com/submit",
            "accept: application/json",
            "a body"
          ]
        }
      ]
    },
    {
      "path": "examples/logging.roc",
      "cases": [
        {
          "name": "happy",
          "args": [
            "https://example.com/log"
          ],
          "stdout_contains": [
            "handling GET https://example.com/log",
            "Logged."
          ],
          "stderr_contains": [
            "this goes to the error log"
          ]
        }
      ]
    },
    {
      "path": "examples/routing.roc",
      "cases": [
        {
          "name": "known-route",
          "args": [
            "https://example.com/health"
          ],
          "stdout_contains": [
            "ok"
          ]
        },
        {
          "name": "unknown-route",
          "args": [
            "https://example.com/nope"
          ],
          "exit_code": 1,
          "stdout_contains": [
            "not found"
          ]
        }
      ]
    },
    {
      "path": "examples/headers.roc",
      "cases": [
        {
          "name": "reads-request-header",
          "args": [
            "https://example.com/",
            "GET",
            "",
            "accept:application/json"
          ],
          "stdout_contains": [
            "accept: application/json",
            "x-powered-by: roc"
          ]
        },
        {
          "name": "missing-request-header",
          "args": [
            "https://example.com/"
          ],
          "stdout_contains": [
            "accept: (absent)"
          ]
        }
      ]
    }
  ]
}
