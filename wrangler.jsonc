{
  // Config for this repo's own demo Worker (worker/app.roc, a KV hit counter).
  //
  // It is deliberately minimal: only the bindings the demo actually uses, so
  // `npm run deploy` does not require account resources it never touches.
  // For a config showing every binding the platform supports, and the two
  // settings any Worker on this platform must set, see wrangler.example.jsonc.
  //
  // This file is not part of the published platform — `bundle.sh` ships only
  // platform/*.roc and the prebuilt host libraries. Apps built on the platform
  // bring their own wrangler config.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roc-cloudflare",
  "main": "worker/entry.js",
  "compatibility_date": "2026-08-01",

  // Required by the platform: workers-zig's shim.js imports node:fs /
  // node:path / node:stream for its WASI and socket support.
  "compatibility_flags": ["nodejs_compat"],

  // npx wrangler kv namespace create COUNTER
  // -> prints the 32-char hex namespace id, which is what `id` wants
  "kv_namespaces": [
    {
      "binding": "COUNTER",
      "id": "d8f5d3d848904211b82a5aef10126013",
    },
  ],

  // Required by the platform: loads worker.wasm as a module.
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": false,
    },
  ],
}
