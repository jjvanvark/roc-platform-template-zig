{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roc-cloudflare",
  "main": "worker/entry.js",
  "compatibility_date": "2026-08-01",
  // workers-zig's shim.js imports node:fs / node:path / node:stream for its
  // WASI and socket support, so the runtime needs the Node compat layer.
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "COUNTER",
      // Local `wrangler dev` simulates KV, so this id only matters on deploy.
      "id": "roc_cloudflare_counter"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "roc-cloudflare-bucket"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roc-cloudflare-db",
      "database_id": "roc_cloudflare_db"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "roc-cloudflare-jobs"
      }
    ]
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": false
    }
  ]
}
